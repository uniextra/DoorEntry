# ==============================================================================
# DoorEntry Environment Configuration Example
# Copy this file to .env and fill in your values
# ==============================================================================

# Timezone for container logs and timestamping
TZ=Europe/Madrid

# Host local IP address (required for SIP SDP routing in some network setups)
LOCAL_IP=192.168.1.50

# Optional: Legrand Eliot Cloud Credentials
# If set, DoorEntry will authenticate automatically at startup
LEGRAND_USER=user@example.com
LEGRAND_PASSWORD=your_legrand_password

# Optional: Hardware and SIP overrides (auto-discovered if cloud login is used)
# PLANT_ID=
# GATEWAY_ID=
# ENTRANCE_PANEL_GUID=
# SECONDARY_PANEL_GUID=
# SIP_USER=
# SIP_PASSWORD=
# SIP_SERVER=vdesip.bs.iotleg.com
# SIP_PORT=5061
# SIP_DOMAIN=

# Optional: Legrand Eliot Developer / Azure AD API Overrides
# LEGRAND_APP_CLIENT_SECRET=
# LEGRAND_SUBSCRIPTION_KEY=
# LEGRAND_APP_CLIENT_ID=
# LEGRAND_APP_TENANT_ID=
